{
  "name": "gantree",
  "version": "0.1.36",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "type": "module",
  "scripts": {
    "dev": "vinext dev -H 127.0.0.1",
    "build": "vinext build",
    "start": "vinext start -H ${HOST:-127.0.0.1}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "docker:build": "docker build -t gantree:local .",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "pages": "node scripts/pages.mjs"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "^3.2.1",
    "smol-toml": "^1.4.2",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "latest",
    "@testing-library/react": "^16.3.2",
    "@types/dockerode": "^3.3.44",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "tailwindcss": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
}

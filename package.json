{
  "name": "gantree",
  "version": "0.1.72",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.2.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev --host 127.0.0.1 --port 3000",
    "build": "vinext build",
    "start": "vinext start -H ${HOST:-127.0.0.1}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "docker:build": "docker build -t gantree:local .",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "pages": "node scripts/pages.mjs",
    "seed": "vite-node --config vitest.config.ts scripts/seed.ts"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "^3.10.1",
    "smol-toml": "^1.9.1",
    "vinext": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "latest",
    "@testing-library/react": "^16.3.3",
    "@types/dockerode": "^4.0.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.2",
    "marked": "^18.1.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}

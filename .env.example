# Optional. Defaults talk to the local Docker socket.
# DOCKER_SOCKET=/var/run/docker.sock
# GANTREE_ROOT=.
# GANTREE_TOML=./gantree.toml
# GANTREE_TOOLS=/path/to/mcp-binaries
# GANTREE_MCP_ROOT=./repos/ai-gantry/repos
# Console-in-Docker: host path of this checkout (compose sets PWD).
# GANTREE_HOST_ROOT=/opt/gantree
# Yard sqlite (operators, sessions, samples, audit). Never a crane's data/gantry.db.
# GANTREE_DB=./gantree.db
# Optional uid:gid override. Compose already uses your shell UID (default 1000:1000).
# GANTREE_CRANE_USER=1000:1000

# vinext bind (npm start already sets 127.0.0.1)
# HOST=127.0.0.1
# PORT=3000

# Loopback-only auto-login for screenshots / npm run dev. Never set these in
# compose — HOST=0.0.0.0 there, so GANTREE_DEV is ignored on a LAN publish.
# Passphrase still ≥10 characters, not blank / your name / a common password
# (same as /setup). Unset to photograph /login.
# GANTREE_DEV=1
# GANTREE_DEV_OPERATOR=bob
# GANTREE_DEV_PASSPHRASE=bob-dev-ok

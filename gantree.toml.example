# Inventory — no secrets. Copy to gantree.toml (gitignored).
# If this file is missing, gantree discovers running ai-gantry containers.
#
# yard = "home"  # Mini / LAN — Cast allowed
# yard = "cloud" # VM — life-cast refused at build

yard = "home"

